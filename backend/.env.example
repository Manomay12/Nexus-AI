# ====================================================
# NEXUS AI BACKEND CONFIGURATION
# ====================================================

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase Vector Database
# Get these credentials from your Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Embedding Configuration
# Mode: "production" uses Google Gemini text-embedding-004 (768 dimensions)
#       "mock" uses local deterministic 768-dim mock vectors for offline development/hackathons
EMBEDDING_MODE=production
EMBEDDING_DIMENSION=768

# Offline / Hackathon Demo Mode
# If true, runs entirely with local deterministic fallback even if external APIs fail
DEMO_MODE=false

# Optional Google Earth Engine Backend Integration
# Keep false by default for zero-friction setup. If enabled, provide GEE service account credentials.
EARTH_ENGINE_ENABLED=false
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY=
