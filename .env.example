# NEXUS AI — Frontend Configuration
# Public variables prefixed with VITE_ are safe for frontend consumption

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Demo Mode Flag (Set to true to force client-side mock fallback even without backend)
VITE_DEMO_MODE=false

# Optional Public Map Providers / Supabase Public Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
